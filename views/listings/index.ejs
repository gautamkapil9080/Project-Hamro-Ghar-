<% layout("/layout/boilerplate") %> 
     <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
         <% for (collections of listingValues){ %>
            <a href="/listings/<%=collections.id%>" class="alink">
                <div class="card col">
                    <img src="https://images.unsplash.com/photo-1568605114967-8130f3a36994" 
                     class="card-img-top" alt="..."
                      style="height:20rem;" >
                    </div>

             

            <div class="card-body"> 
                <p class="card-text" > 
                        <b><%=collections.Title%></b><br>
                        <%=collections.Price%>/ One stay </p>
            </div> 
        </a>
                 <% } %> 
            </div> 
        